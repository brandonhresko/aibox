#!/usr/bin/env bash
# aibox - one persistent, agent-neutral Docker sandbox per project.

set -euo pipefail
unset CDPATH

# Replaced by the release workflow. A checkout intentionally reports "dev".
CLI_VERSION="${AIBOX_CLI_VERSION:-__CLI_VERSION__}"
SCHEMA_VERSION="3"
NODE_VERSION="24"
DEFAULT_PIDS="4096"
CONFIG_DIR="${AIBOX_CONFIG_DIR:-${HOME}/.aibox}"
FORWARD_IMAGE="${AIBOX_FORWARD_IMAGE:-alpine/socat@sha256:beb4a68d9e4fe6b0f21ea774a0fde6c31f580dde6368939ed70100c5385b015e}"

[[ "$CLI_VERSION" == "__CLI_VERSION__" ]] && CLI_VERSION="dev"

PROJECT_DIR=""
SLUG=""
HASH=""
SANDBOX=""
IMAGE=""
HOME_VOLUME=""
NETWORK=""
LOCK_PATH=""
SESSION_MARKER=""
VALIDATION_CONTAINER=""
CONFIG_CPUS="0"
CONFIG_MEMORY="0"
CONFIG_PIDS="$DEFAULT_PIDS"

_notice() { printf '%s\n' "$*" >&2; }
_warn() { printf 'Warning: %s\n' "$*" >&2; }
_die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
_usage_error() { printf 'Error: %s\nRun "aibox help" for usage.\n' "$*" >&2; exit 2; }

_help() {
  cat <<'HELP'
aibox - Run commands in a persistent, project-scoped Docker sandbox.

Usage:
  aibox
  aibox [--dir PATH] up [--image IMAGE] [--cpus N] [--memory SIZE]
                          [--pids N] [--rebuild]
  aibox [--dir PATH] run [--env NAME]... <command> [arguments...]
  aibox [--dir PATH] shell [command...]
  aibox [--dir PATH] stop [--all]
  aibox [--dir PATH] status
  aibox [--dir PATH] remove [--purge] [--yes]
  aibox [--dir PATH] port-forward PORT|HOST_PORT:CONTAINER_PORT ...
  aibox [--dir PATH] port-forward --list | --stop PORT | --stop-all
  aibox version
  aibox help

The selected project is mounted read/write at the same absolute path. Its
private /home/aibox volume persists across replacement. Port forwards bind
only to 127.0.0.1. AI Box does not install or launch an AI agent or provide
remote transport.
HELP
}

_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -d' ' -f1
  else
    shasum -a 256 | cut -d' ' -f1
  fi
}

_validate_cpus() {
  local value="$1" source="$2"
  if [[ ! "$value" =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)$ ]]; then
    [[ "$source" == --* ]] && _usage_error "Invalid CPU limit '${value}'; use 0 or a positive number such as 1.5."
    _die "Invalid CPU limit '${value}' from ${source}; use 0 or a positive number such as 1.5."
  fi
}

_validate_memory() {
  local value="$1" source="$2"
  if [[ "$value" != "0" && ! "$value" =~ ^[1-9][0-9]*([bBkKmMgG])?$ ]]; then
    [[ "$source" == --* ]] && _usage_error "Invalid memory limit '${value}'; use 0 or a Docker size such as 256m."
    _die "Invalid memory limit '${value}' from ${source}; use 0 or a Docker size such as 256m."
  fi
}

_validate_pids() {
  local value="$1" source="$2"
  if [[ ! "$value" =~ ^[0-9]+$ ]]; then
    [[ "$source" == --* ]] && _usage_error "Invalid process limit '${value}'; use 0 or a positive integer."
    _die "Invalid process limit '${value}' from ${source}; use 0 or a positive integer."
  fi
}

_is_zero_number() {
  awk -v value="$1" 'BEGIN { exit ! (value + 0 == 0) }'
}

_memory_bytes() {
  local value="$1" number suffix multiplier=1
  number="${value%[bBkKmMgG]}"
  suffix="${value#$number}"
  case "$suffix" in
    b|B|"") multiplier=1 ;;
    k|K) multiplier=1024 ;;
    m|M) multiplier=1048576 ;;
    g|G) multiplier=1073741824 ;;
  esac
  awk -v number="$number" -v multiplier="$multiplier" 'BEGIN { printf "%.0f\n", number * multiplier }'
}

_cpus_from_nano() {
  awk -v nano="$1" 'BEGIN { if (nano == 0) print "0"; else printf "%.9g\n", nano / 1000000000 }'
}

_load_config() {
  local key value
  [[ -f "${CONFIG_DIR}/config" ]] || return 0
  while IFS='=' read -r key value || [[ -n "$key" ]]; do
    [[ -z "$key" || "$key" == \#* || -z "$value" ]] && continue
    case "$key" in
      node_version)
        [[ "$value" =~ ^[0-9]+$ ]] \
          || _die "Invalid node_version in ${CONFIG_DIR}/config: expected a major version number."
        NODE_VERSION="$value"
        ;;
      cpus)
        _validate_cpus "$value" "${CONFIG_DIR}/config"
        CONFIG_CPUS="$value"
        ;;
      memory)
        _validate_memory "$value" "${CONFIG_DIR}/config"
        CONFIG_MEMORY="$value"
        ;;
      pids)
        _validate_pids "$value" "${CONFIG_DIR}/config"
        CONFIG_PIDS="$value"
        ;;
    esac
  done < "${CONFIG_DIR}/config"
}

_canonical_dir() {
  local selected="$1"
  [[ -d "$selected" ]] || _die "Project directory does not exist: ${selected}"
  (cd "$selected" && pwd -P)
}

_path_is_unsafe() {
  local path="$1"
  case "$path" in
    /|"$HOME"|/Users|/home|/Volumes|/mnt|/tmp|/var|/etc|/usr|/opt|/private|/private/tmp|/private/var|/private/etc|*:* ) return 0 ;;
  esac
  return 1
}

_set_project() {
  if _path_is_unsafe "${1%/}"; then
    _die "Refusing unsafe project path: ${1%/}. Select a specific project directory."
  fi
  PROJECT_DIR="$(_canonical_dir "$1")"
  if _path_is_unsafe "$PROJECT_DIR"; then
    _die "Refusing unsafe project path: ${PROJECT_DIR}. Select a specific project directory."
  fi

  SLUG="$(basename "$PROJECT_DIR" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g; s/_/-/g; s/^-*//; s/-*$//')"
  [[ -n "$SLUG" ]] || SLUG="project"
  SLUG="${SLUG:0:48}"
  HASH="$(printf '%s' "$PROJECT_DIR" | _sha256 | cut -c1-6)"
  SANDBOX="aibox-${SLUG}-${HASH}"
  HOME_VOLUME="$SANDBOX"
  NETWORK="$SANDBOX"
  IMAGE="aibox:${CLI_VERSION}-node${NODE_VERSION}"
  LOCK_PATH="${CONFIG_DIR}/locks/${SANDBOX}"
}

_docker_endpoint() {
  if [[ -n "${DOCKER_HOST:-}" ]]; then
    printf '%s\n' "$DOCKER_HOST"
    return 0
  fi
  docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null | head -1
}

_require_local_docker() {
  local endpoint
  command -v docker >/dev/null 2>&1 \
    || _die "Docker CLI not found. Install Docker, Colima, or OrbStack and retry."
  endpoint="$(_docker_endpoint)" || _die "Could not inspect the active Docker context."
  case "$endpoint" in
    unix://*) ;;
    *) _die "Refusing remote Docker endpoint ${endpoint:-unknown}. AI Box requires a local Unix socket because project bind paths belong to the daemon host." ;;
  esac
}

_ensure_docker() {
  _require_local_docker
  docker info >/dev/null 2>&1 && return 0

  if command -v colima >/dev/null 2>&1; then
    _notice "Docker is stopped; starting Colima..."
    colima start >&2
  elif [[ "$(uname -s)" == "Darwin" && -d /Applications/OrbStack.app ]]; then
    _notice "Docker is stopped; starting OrbStack..."
    open -a OrbStack
  elif [[ "$(uname -s)" == "Darwin" && -d /Applications/Docker.app ]]; then
    _notice "Docker is stopped; starting Docker Desktop..."
    open -a Docker
  else
    _die "Docker daemon is not reachable. Start it and retry (on Linux: sudo systemctl start docker)."
  fi

  local attempts=0
  until docker info >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    (( attempts < 60 )) || _die "Docker daemon did not become ready within 60 seconds. Start the installed runtime and retry."
    sleep 1
  done
}

_resource_exists() {
  local kind="$1" name="$2"
  case "$kind" in
    container) docker container inspect "$name" >/dev/null 2>&1 ;;
    volume) docker volume inspect "$name" >/dev/null 2>&1 ;;
    network) docker network inspect "$name" >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

_resource_label() {
  local kind="$1" name="$2" key="$3"
  case "$kind" in
    container) docker container inspect --format "{{ index .Config.Labels \"${key}\" }}" "$name" 2>/dev/null ;;
    volume) docker volume inspect --format "{{ index .Labels \"${key}\" }}" "$name" 2>/dev/null ;;
    network) docker network inspect --format "{{ index .Labels \"${key}\" }}" "$name" 2>/dev/null ;;
  esac
}

_assert_owned_resource() {
  local kind="$1" name="$2" schema path role
  _resource_exists "$kind" "$name" || return 0
  schema="$(_resource_label "$kind" "$name" 'aibox.schema')"
  path="$(_resource_label "$kind" "$name" 'aibox.path')"
  role="$(_resource_label "$kind" "$name" 'aibox.role')"
  if [[ "$schema" != "$SCHEMA_VERSION" || "$path" != "$PROJECT_DIR" || "$role" != "sandbox" ]]; then
    _die "Refusing foreign ${kind} named ${name}. Expected schema 3 sandbox labels for ${PROJECT_DIR}; inspect or remove it manually."
  fi
}

_assert_project_resources() {
  _assert_owned_resource container "$SANDBOX"
  _assert_owned_resource volume "$HOME_VOLUME"
  _assert_owned_resource network "$NETWORK"
}

_lock_owned_by_aibox() {
  local pid="$1" command_text
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  command_text="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  if [[ "$command_text" =~ (^|[\/[:space:]])aibox([[:space:]]|$) ]]; then
    return 0
  fi
  # A newly started Bash process can briefly appear before its script argument.
  # Recheck once when the run/shell marker proves this PID is in the handoff.
  if [[ -f "${CONFIG_DIR}/sessions/${SANDBOX}/${pid}" ]]; then
    sleep 0.02
    command_text="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    [[ "$command_text" =~ (^|[\/[:space:]])aibox([[:space:]]|$) ]] && return 0
  fi
  return 1
}

_release_lock() {
  local owner
  [[ -n "$LOCK_PATH" && -L "$LOCK_PATH" ]] || return 0
  owner="$(readlink "$LOCK_PATH" 2>/dev/null || true)"
  [[ "$owner" == "$$" ]] && rm -f -- "$LOCK_PATH"
  return 0
}

_acquire_lock() {
  local owner waits=0
  mkdir -p "${CONFIG_DIR}/locks"
  while ! ln -s "$$" "$LOCK_PATH" 2>/dev/null; do
    owner="$(readlink "$LOCK_PATH" 2>/dev/null || true)"
    if ! _lock_owned_by_aibox "$owner"; then
      rm -f -- "$LOCK_PATH" 2>/dev/null || true
      continue
    fi
    waits=$((waits + 1))
    if (( waits % 100 == 0 )); then
      _notice "Waiting for another AI Box operation on ${SANDBOX}..."
    fi
    sleep 0.1
  done
}

_cleanup() {
  AIBOX_EXIT_STATUS=$?
  trap - EXIT HUP INT TERM
  _release_lock
  [[ -n "$SESSION_MARKER" ]] && rm -f -- "$SESSION_MARKER" 2>/dev/null || true
  if [[ -n "$VALIDATION_CONTAINER" ]]; then
    docker container rm --force "$VALIDATION_CONTAINER" >/dev/null 2>&1 || true
  fi
  exit "$AIBOX_EXIT_STATUS"
}

_begin_session() {
  local session_dir="${CONFIG_DIR}/sessions/${SANDBOX}"
  mkdir -p "$session_dir"
  SESSION_MARKER="${session_dir}/$$"
  : > "$SESSION_MARKER"
}

_active_session_count() {
  local session_dir="${CONFIG_DIR}/sessions/${SANDBOX}" marker pid count=0
  [[ -d "$session_dir" ]] || { printf '0\n'; return 0; }
  for marker in "$session_dir"/*; do
    [[ -f "$marker" ]] || continue
    pid="${marker##*/}"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      count=$((count + 1))
    fi
  done
  printf '%s\n' "$count"
}

_write_build_inputs() {
  mkdir -p "$CONFIG_DIR"
  cat > "${CONFIG_DIR}/Dockerfile" <<DOCKERFILE
FROM node:${NODE_VERSION}-bookworm

RUN apt-get update \\
 && apt-get install -y --no-install-recommends zsh sudo ripgrep fzf jq less procps curl tmux \\
 && rm -rf /var/lib/apt/lists/*

RUN userdel -r node 2>/dev/null || true \\
 && useradd -m -u 1000 -s /usr/bin/zsh aibox \\
 && printf 'aibox ALL=(ALL) NOPASSWD:ALL\\n' > /etc/sudoers.d/aibox \\
 && chmod 0440 /etc/sudoers.d/aibox

ENV HOME=/home/aibox
ENV PATH=/home/aibox/.local/bin:\$PATH

COPY entrypoint.sh /usr/local/bin/aibox-entrypoint
RUN chmod 0755 /usr/local/bin/aibox-entrypoint
USER aibox
WORKDIR /home/aibox
ENTRYPOINT ["/usr/local/bin/aibox-entrypoint"]
CMD ["sleep", "infinity"]
DOCKERFILE

  if [[ -f "${CONFIG_DIR}/Dockerfile.extra" ]]; then
    printf '\n' >> "${CONFIG_DIR}/Dockerfile"
    cat "${CONFIG_DIR}/Dockerfile.extra" >> "${CONFIG_DIR}/Dockerfile"
  fi

  cat > "${CONFIG_DIR}/entrypoint.sh" <<'ENTRYPOINT'
#!/usr/bin/env bash
set -e
rm -f /tmp/aibox-ready
sudo chown aibox:aibox /home/aibox
if [[ ! -e /home/aibox/.zshrc ]]; then
  printf 'autoload -Uz compinit && compinit\nPROMPT="%%F{cyan}%%1~%%f %%# "\n' > /home/aibox/.zshrc
fi
touch /tmp/aibox-ready
exec "$@"
ENTRYPOINT
  chmod 0755 "${CONFIG_DIR}/entrypoint.sh"
  printf '*\n!Dockerfile\n!entrypoint.sh\n' > "${CONFIG_DIR}/.dockerignore"
}

_build_fingerprint() {
  { cat "${CONFIG_DIR}/Dockerfile"; cat "${CONFIG_DIR}/entrypoint.sh"; } | _sha256
}

_check_disk_space() {
  local available_kb
  available_kb="$(df -Pk "$CONFIG_DIR" | awk 'NR == 2 { print $4 }')"
  [[ "$available_kb" =~ ^[0-9]+$ ]] || _die "Could not determine free disk space before building ${IMAGE}."
  if (( available_kb < 5242880 )); then
    _die "Less than 5 GB is free on the Docker host filesystem. Free space before building ${IMAGE}."
  elif (( available_kb < 10485760 )); then
    _warn "Less than 10 GB is free; the image build may exhaust disk space."
  fi
}

_image_fingerprint() {
  docker image inspect --format '{{ index .Config.Labels "aibox.build-fingerprint" }}' "$IMAGE" 2>/dev/null || true
}

_build_default_image() {
  local wanted
  _write_build_inputs
  wanted="$(_build_fingerprint)"
  _check_disk_space
  _notice "Building ${IMAGE}; this may take a few minutes..."
  docker build --pull --label "aibox.build-fingerprint=${wanted}" -t "$IMAGE" "$CONFIG_DIR" >&2 \
    || _die "Failed to build ${IMAGE}. Review the Docker output above and retry."
  _notice "Built ${IMAGE}."
}

_ensure_image() {
  local force="${1:-false}" wanted current
  _write_build_inputs
  wanted="$(_build_fingerprint)"
  current="$(_image_fingerprint)"
  if [[ "$force" != true && "$current" == "$wanted" ]]; then
    return 0
  fi
  _build_default_image
}

_validate_custom_image() {
  local image="$1" configured_user entrypoint state attempts=0 exit_code logs
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    _die "Custom image '${image}' is not a valid local Docker image. Build or pull it first."
  fi
  configured_user="$(docker image inspect --format '{{.Config.User}}' "$image" 2>/dev/null || true)"
  [[ "$configured_user" == "aibox" ]] \
    || _die "Custom image '${image}' is incompatible: its configured user must be 'aibox'."
  entrypoint="$(docker image inspect --format '{{json .Config.Entrypoint}}' "$image" 2>/dev/null || true)"
  [[ -n "$entrypoint" && "$entrypoint" != "null" && "$entrypoint" != '<no value>' ]] \
    || _die "Custom image '${image}' is incompatible: it must define a passthrough entrypoint."

  VALIDATION_CONTAINER="aibox-validate-$$-${RANDOM}"
  if ! docker create --name "$VALIDATION_CONTAINER" "$image" sh -c '
    test "$(id -u)" = 1000
    test "$HOME" = /home/aibox
    command -v sleep >/dev/null
    printf aibox-validation-ok
  ' >/dev/null; then
    docker container rm --force "$VALIDATION_CONTAINER" >/dev/null 2>&1 || true
    VALIDATION_CONTAINER=""
    _die "Custom image '${image}' could not be started for compatibility validation."
  fi
  if ! docker start "$VALIDATION_CONTAINER" >/dev/null; then
    docker container rm --force "$VALIDATION_CONTAINER" >/dev/null 2>&1 || true
    VALIDATION_CONTAINER=""
    _die "Custom image '${image}' failed its entrypoint validation."
  fi
  while :; do
    state="$(docker container inspect --format '{{.State.Status}}' "$VALIDATION_CONTAINER" 2>/dev/null || true)"
    [[ "$state" == "exited" || "$state" == "dead" ]] && break
    attempts=$((attempts + 1))
    if (( attempts >= 30 )); then
      docker container rm --force "$VALIDATION_CONTAINER" >/dev/null 2>&1 || true
      VALIDATION_CONTAINER=""
      _die "Custom image '${image}' is incompatible: its entrypoint did not pass the validation command through."
    fi
    sleep 0.1
  done
  exit_code="$(docker container inspect --format '{{.State.ExitCode}}' "$VALIDATION_CONTAINER")"
  logs="$(docker logs "$VALIDATION_CONTAINER" 2>/dev/null || true)"
  docker container rm "$VALIDATION_CONTAINER" >/dev/null 2>&1 || true
  VALIDATION_CONTAINER=""
  if [[ "$exit_code" != "0" || "$logs" != *aibox-validation-ok* ]]; then
    _die "Custom image '${image}' is incompatible: require UID 1000, HOME=/home/aibox, sleep, and a passthrough entrypoint."
  fi
}

_container_state() {
  if ! _resource_exists container "$SANDBOX"; then
    printf 'absent\n'
  else
    docker container inspect --format '{{.State.Status}}' "$SANDBOX"
  fi
}

_create_support_resources() {
  if ! _resource_exists network "$NETWORK"; then
    if ! docker network create \
      --label "aibox.schema=${SCHEMA_VERSION}" \
      --label "aibox.path=${PROJECT_DIR}" \
      --label "aibox.slug=${SLUG}" \
      --label "aibox.hash=${HASH}" \
      --label "aibox.version=${CLI_VERSION}" \
      --label 'aibox.role=sandbox' \
      "$NETWORK" >/dev/null; then
      _die "Could not create network ${NETWORK}. If Docker reports address-pool exhaustion, configure smaller default-address-pools in the Docker daemon."
    fi
  fi

  if ! _resource_exists volume "$HOME_VOLUME"; then
    docker volume create \
      --label "aibox.schema=${SCHEMA_VERSION}" \
      --label "aibox.path=${PROJECT_DIR}" \
      --label "aibox.slug=${SLUG}" \
      --label "aibox.hash=${HASH}" \
      --label "aibox.version=${CLI_VERSION}" \
      --label 'aibox.role=sandbox' \
      "$HOME_VOLUME" >/dev/null \
      || _die "Could not create private home volume ${HOME_VOLUME}."
  fi
}

_create_container() {
  local target_image="$1" image_source="$2" cpus="$3" memory="$4" pids="$5" restart_policy="$6"
  local docker_args=(create
    --name "$SANDBOX"
    --hostname "${SLUG:0:63}"
    --network "$NETWORK"
    --restart "$restart_policy"
    --init
    --add-host host.docker.internal:host-gateway
    --workdir "$PROJECT_DIR"
    --mount "type=bind,src=${PROJECT_DIR},dst=${PROJECT_DIR}"
    --mount "type=volume,src=${HOME_VOLUME},dst=/home/aibox"
    --label "aibox.schema=${SCHEMA_VERSION}"
    --label "aibox.path=${PROJECT_DIR}"
    --label "aibox.slug=${SLUG}"
    --label "aibox.hash=${HASH}"
    --label "aibox.version=${CLI_VERSION}"
    --label 'aibox.role=sandbox'
    --label "aibox.image-source=${image_source}")
  if ! _is_zero_number "$cpus"; then
    docker_args+=(--cpus "$cpus")
  fi
  if [[ "$memory" != "0" ]]; then
    docker_args+=(--memory "$memory" --memory-swap "$memory")
  fi
  if [[ "$pids" != "0" ]]; then
    docker_args+=(--pids-limit "$pids")
  fi
  # This command runs only after a compatible entrypoint passes control
  # through, so independent custom images can satisfy the same readiness
  # protocol without inheriting AI Box's entrypoint.
  docker_args+=("$target_image" sh -c 'touch /tmp/aibox-ready && exec sleep infinity')
  docker "${docker_args[@]}" >/dev/null
}

_wait_ready() {
  local attempts=0
  until docker exec "$SANDBOX" test -f /tmp/aibox-ready >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if (( attempts >= 50 )); then
      docker logs "$SANDBOX" >&2 || true
      return 1
    fi
    sleep 0.1
  done
}

_ensure_entry_sandbox_locked() {
  local state source
  _assert_project_resources
  state="$(_container_state)"

  if [[ "$state" == "created" ]]; then
    _notice "Replacing incomplete Created-state sandbox ${SANDBOX}..."
    docker container rm "$SANDBOX" >/dev/null \
      || _die "Could not remove incomplete sandbox ${SANDBOX}."
    state="absent"
  fi

  case "$state" in
    absent)
      _ensure_image false
      _create_support_resources
      _notice "Creating sandbox ${SANDBOX}..."
      _create_container "$IMAGE" default "$CONFIG_CPUS" "$CONFIG_MEMORY" "$CONFIG_PIDS" unless-stopped \
        || _die "Could not create ${SANDBOX}. Check the bind path and Docker error above."
      docker start "$SANDBOX" >/dev/null || _die "Could not start ${SANDBOX}."
      ;;
    running)
      source="$(_resource_label container "$SANDBOX" 'aibox.image-source')"
      [[ "$source" == "default" ]] && _ensure_image false
      ;;
    exited|dead)
      source="$(_resource_label container "$SANDBOX" 'aibox.image-source')"
      [[ "$source" == "default" ]] && _ensure_image false
      _notice "Starting sandbox ${SANDBOX}..."
      docker start "$SANDBOX" >/dev/null || _die "Could not start ${SANDBOX}."
      ;;
    restarting)
      _notice "Waiting for restarting sandbox ${SANDBOX}..."
      ;;
    *) _die "Sandbox ${SANDBOX} is ${state}; resolve that Docker state and retry." ;;
  esac
  _wait_ready || _die "Sandbox ${SANDBOX} did not become ready."
}

_container_is_stale() {
  local container_image current_image configured_image source
  _resource_exists container "$SANDBOX" || return 1
  source="$(_resource_label container "$SANDBOX" 'aibox.image-source')"
  [[ "$source" == "default" ]] || return 1
  configured_image="$(docker container inspect --format '{{.Config.Image}}' "$SANDBOX" 2>/dev/null || true)"
  container_image="$(docker container inspect --format '{{.Image}}' "$SANDBOX" 2>/dev/null || true)"
  current_image="$(docker image inspect --format '{{.Id}}' "$configured_image" 2>/dev/null || true)"
  [[ -n "$container_image" && -n "$current_image" && "$container_image" != "$current_image" ]]
}

_warn_if_stale() {
  if _container_is_stale; then
    _warn "Sandbox ${SANDBOX} uses an older default image; run 'aibox up' to replace it when idle."
  fi
}

_activity_state() {
  local init_pid top_output pid ppid args init_seen=0 idle_seen=0 unexpected=0 rows=0
  init_pid="$(docker container inspect --format '{{.State.Pid}}' "$SANDBOX" 2>/dev/null || true)"
  if [[ ! "$init_pid" =~ ^[1-9][0-9]*$ ]]; then
    _warn "Cannot establish safety for ${SANDBOX}: Docker did not report its init PID."
    printf 'unknown\n'
    return 0
  fi
  if ! top_output="$(docker top "$SANDBOX" -eo pid,ppid,args 2>/dev/null)"; then
    _warn "Cannot establish safety for ${SANDBOX}: docker top failed."
    printf 'unknown\n'
    return 0
  fi

  while read -r pid ppid args; do
    [[ "$pid" =~ ^[0-9]+$ && "$ppid" =~ ^[0-9]+$ ]] || continue
    rows=$((rows + 1))
    if [[ "$pid" == "$init_pid" ]]; then
      init_seen=$((init_seen + 1))
    elif [[ "$ppid" == "$init_pid" && "$args" =~ (^|/)sleep[[:space:]]+infinity$ ]]; then
      idle_seen=$((idle_seen + 1))
    else
      unexpected=$((unexpected + 1))
    fi
  done <<EOF
$top_output
EOF

  if (( rows == 0 || init_seen != 1 || idle_seen != 1 )); then
    _warn "Cannot establish safety for ${SANDBOX}: Docker process data did not contain the expected init and idle process."
    printf 'unknown\n'
  elif (( unexpected > 0 )); then
    printf 'active\n'
  else
    printf 'idle\n'
  fi
}

_docker_exec() {
  local args=(exec -i)
  if [[ -t 0 && -t 1 ]]; then
    args=(exec -it)
  fi
  docker "${args[@]}" "$@"
}

_require_replacement_idle() {
  local state="$1" sessions activity
  sessions="$(_active_session_count)"
  if (( sessions > 0 )); then
    _die "Refusing to replace ${SANDBOX}: ${sessions} AI Box session(s) are active. Let them finish or run 'aibox stop', then retry 'aibox up'."
  fi
  if [[ "$state" == "running" ]]; then
    activity="$(_activity_state)"
    case "$activity" in
      idle) ;;
      active) _die "Refusing to replace ${SANDBOX}: background processes are active. Stop them or run 'aibox stop', then retry 'aibox up'." ;;
      *) _die "Refusing to replace ${SANDBOX}: cannot establish safety from Docker process inspection. Run 'aibox stop', then retry 'aibox up'." ;;
    esac
  fi
}

_apply_live_limits() {
  local cpus_set="$1" cpus="$2" memory_set="$3" memory="$4" pids_set="$5" pids="$6"
  local current_memory target_memory docker_args=(update)
  if [[ "$cpus_set" == true ]] && ! _is_zero_number "$cpus"; then
    docker_args+=(--cpus "$cpus")
  fi
  if [[ "$memory_set" == true && "$memory" != "0" ]]; then
    current_memory="$(docker container inspect --format '{{.HostConfig.Memory}}' "$SANDBOX")"
    target_memory="$(_memory_bytes "$memory")"
    if [[ "$current_memory" =~ ^[0-9]+$ ]] && (( current_memory > 0 && target_memory < current_memory )); then
      _warn "Lowering memory below current usage may trigger reclaim or an out-of-memory kill."
    fi
    docker_args+=(--memory "$memory" --memory-swap "$memory")
  fi
  if [[ "$pids_set" == true ]]; then
    if [[ "$pids" == "0" ]]; then
      docker_args+=(--pids-limit -1)
    else
      docker_args+=(--pids-limit "$pids")
    fi
  fi
  if (( ${#docker_args[@]} > 1 )); then
    docker "${docker_args[@]}" "$SANDBOX" >/dev/null \
      || _die "Docker rejected the requested live resource update; the Docker error above is authoritative."
  fi
}

_restart_forwarders() {
  local ids id state
  ids="$(docker ps --all --quiet --filter "label=aibox.schema=${SCHEMA_VERSION}" --filter 'label=aibox.role=forward' --filter "label=aibox.path=${PROJECT_DIR}")"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    state="$(docker container inspect --format '{{.State.Status}}' "$id")"
    if [[ "$state" != "running" ]]; then
      docker start "$id" >/dev/null \
        || _die "Could not restart forwarder ${id}; its host port may now be in use."
    fi
  done <<EOF
$ids
EOF
}

_replace_container() {
  local old_state="$1" target_image="$2" image_source="$3" cpus="$4" memory="$5" pids="$6" restart_policy="$7"
  local previous="${SANDBOX}.prev" restored=false
  if _resource_exists container "$previous"; then
    _die "Cannot replace ${SANDBOX}: recovery container ${previous} already exists. Inspect it manually before retrying."
  fi

  _notice "Replacing ${SANDBOX} transactionally..."
  if [[ "$old_state" == "running" ]]; then
    docker stop "$SANDBOX" >/dev/null || _die "Could not stop ${SANDBOX}; replacement was not started."
  fi
  docker rename "$SANDBOX" "$previous" \
    || _die "Could not preserve ${SANDBOX} as ${previous}; replacement was not started."

  if _create_container "$target_image" "$image_source" "$cpus" "$memory" "$pids" "$restart_policy" \
    && docker start "$SANDBOX" >/dev/null \
    && _wait_ready; then
    docker container rm "$previous" >/dev/null \
      || _warn "Replacement succeeded, but Docker could not remove ${previous}."
    _restart_forwarders
    _notice "Replaced ${SANDBOX}; its private home and project files were retained."
    return 0
  fi

  _warn "The replacement did not become ready; restoring the previous sandbox."
  if _resource_exists container "$SANDBOX"; then
    docker container rm --force "$SANDBOX" >/dev/null 2>&1 || true
  fi
  if docker rename "$previous" "$SANDBOX"; then
    restored=true
    if [[ "$old_state" == "running" ]]; then
      docker start "$SANDBOX" >/dev/null \
        || _die "Replacement failed and the previous sandbox was renamed back, but it could not be restarted."
      _wait_ready || _die "Replacement failed and the previous sandbox restarted but did not become ready."
    fi
  fi
  if [[ "$restored" == true ]]; then
    _die "Replacement failed; the previous sandbox was restored in its ${old_state} state."
  fi
  _die "Replacement failed and automatic rollback could not restore ${SANDBOX}; inspect ${previous} immediately."
}

_command_up() {
  local requested_image="" cpus="" memory="" pids="" rebuild=false
  local cpus_set=false memory_set=false pids_set=false image_set=false
  local state source target_source target_image target_id current_image current_id restart_policy
  local current_nano current_memory current_pids merged_cpus merged_memory merged_pids replacement=false
  local idle_checked=false wanted_fingerprint current_fingerprint preview_target_id

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --image)
        [[ $# -ge 2 ]] || _usage_error "--image requires an image reference."
        [[ "$image_set" == false ]] || _usage_error "--image may be specified only once."
        requested_image="$2"; image_set=true; shift 2 ;;
      --cpus)
        [[ $# -ge 2 ]] || _usage_error "--cpus requires a value."
        _validate_cpus "$2" --cpus
        cpus="$2"; cpus_set=true; shift 2 ;;
      --memory)
        [[ $# -ge 2 ]] || _usage_error "--memory requires a value."
        _validate_memory "$2" --memory
        memory="$2"; memory_set=true; shift 2 ;;
      --pids)
        [[ $# -ge 2 ]] || _usage_error "--pids requires a value."
        _validate_pids "$2" --pids
        pids="$2"; pids_set=true; shift 2 ;;
      --rebuild) rebuild=true; shift ;;
      *) _usage_error "Unknown up option: $1" ;;
    esac
  done
  if [[ "$image_set" == true && "$rebuild" == true ]]; then
    _usage_error "--image and --rebuild cannot be used together."
  fi

  _ensure_docker
  _acquire_lock
  _assert_project_resources
  state="$(_container_state)"
  if [[ "$state" == "created" ]]; then
    _notice "Replacing incomplete Created-state sandbox ${SANDBOX}..."
    docker container rm "$SANDBOX" >/dev/null \
      || _die "Could not remove incomplete sandbox ${SANDBOX}."
    state="absent"
  fi

  if [[ "$state" == "absent" ]]; then
    target_image="$IMAGE"
    target_source=default
    if [[ "$image_set" == true ]]; then
      _validate_custom_image "$requested_image"
      target_image="$requested_image"
      target_source=custom
    else
      _ensure_image "$rebuild"
    fi
    _create_support_resources
    merged_cpus="$CONFIG_CPUS"; merged_memory="$CONFIG_MEMORY"; merged_pids="$CONFIG_PIDS"
    [[ "$cpus_set" == true ]] && merged_cpus="$cpus"
    [[ "$memory_set" == true ]] && merged_memory="$memory"
    [[ "$pids_set" == true ]] && merged_pids="$pids"
    _notice "Creating sandbox ${SANDBOX}..."
    _create_container "$target_image" "$target_source" "$merged_cpus" "$merged_memory" "$merged_pids" unless-stopped \
      || _die "Could not create ${SANDBOX}. Check the bind path and Docker error above."
    docker start "$SANDBOX" >/dev/null || _die "Could not start ${SANDBOX}."
    _wait_ready || _die "Sandbox ${SANDBOX} did not become ready."
    _restart_forwarders
    _release_lock
    _notice "Sandbox ${SANDBOX} is ready."
    return 0
  fi

  case "$state" in
    running|exited|dead) ;;
    *) _die "Sandbox ${SANDBOX} is ${state}; resolve that Docker state and retry." ;;
  esac

  source="$(_resource_label container "$SANDBOX" 'aibox.image-source')"
  [[ "$source" == "default" || "$source" == "custom" ]] \
    || _die "Sandbox ${SANDBOX} has an invalid aibox.image-source label."
  current_image="$(docker container inspect --format '{{.Config.Image}}' "$SANDBOX")"
  current_id="$(docker container inspect --format '{{.Image}}' "$SANDBOX")"
  restart_policy="$(docker container inspect --format '{{.HostConfig.RestartPolicy.Name}}' "$SANDBOX")"
  [[ -n "$restart_policy" && "$restart_policy" != "no" ]] || restart_policy=unless-stopped
  current_nano="$(docker container inspect --format '{{.HostConfig.NanoCpus}}' "$SANDBOX")"
  current_memory="$(docker container inspect --format '{{.HostConfig.Memory}}' "$SANDBOX")"
  current_pids="$(docker container inspect --format '{{.HostConfig.PidsLimit}}' "$SANDBOX")"
  [[ "$current_pids" =~ ^-?[0-9]+$ ]] || current_pids=0
  (( current_pids < 0 )) && current_pids=0
  merged_cpus="$(_cpus_from_nano "$current_nano")"
  merged_memory="$current_memory"
  merged_pids="$current_pids"
  [[ "$cpus_set" == true ]] && merged_cpus="$cpus"
  [[ "$memory_set" == true ]] && merged_memory="$memory"
  [[ "$pids_set" == true ]] && merged_pids="$pids"

  # Establish safety before a build, custom-image validation, or any other
  # replace-class work. Image IDs are previewed read-only so a no-op custom
  # image selection does not unnecessarily refuse an active sandbox.
  if [[ "$image_set" == true ]]; then
    preview_target_id="$(docker image inspect --format '{{.Id}}' "$requested_image" 2>/dev/null || true)"
    if [[ -z "$preview_target_id" || "$preview_target_id" != "$current_id" || "$source" != "custom" ]]; then
      replacement=true
    fi
  elif [[ "$source" == "default" ]]; then
    _write_build_inputs
    wanted_fingerprint="$(_build_fingerprint)"
    current_fingerprint="$(_image_fingerprint)"
    preview_target_id="$(docker image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null || true)"
    if [[ "$rebuild" == true || "$current_fingerprint" != "$wanted_fingerprint" || "$preview_target_id" != "$current_id" ]]; then
      replacement=true
    fi
  elif [[ "$rebuild" == true ]]; then
    _die "--rebuild does not replace a custom-image sandbox. Pass the desired image explicitly with --image."
  fi
  if [[ "$cpus_set" == true ]] && _is_zero_number "$cpus" && (( current_nano != 0 )); then
    replacement=true
  fi
  if [[ "$memory_set" == true && "$memory" == "0" ]] && (( current_memory != 0 )); then
    replacement=true
  fi
  if [[ "$replacement" == true ]]; then
    _require_replacement_idle "$state"
    idle_checked=true
  fi

  target_image="$current_image"
  target_source="$source"
  if [[ "$image_set" == true ]]; then
    _validate_custom_image "$requested_image"
    target_image="$requested_image"
    target_source=custom
  elif [[ "$source" == "default" ]]; then
    _ensure_image "$rebuild"
    target_image="$IMAGE"
    target_source=default
  fi
  target_id="$(docker image inspect --format '{{.Id}}' "$target_image" 2>/dev/null || true)"
  [[ -n "$target_id" ]] || _die "Target image '${target_image}' is not available."

  [[ "$target_id" != "$current_id" || "$target_source" != "$source" || "$rebuild" == true ]] && replacement=true
  if [[ "$cpus_set" == true ]] && _is_zero_number "$cpus" && (( current_nano != 0 )); then
    replacement=true
  fi
  if [[ "$memory_set" == true && "$memory" == "0" ]] && (( current_memory != 0 )); then
    replacement=true
  fi

  if [[ "$replacement" == true ]]; then
    [[ "$idle_checked" == true ]] || _require_replacement_idle "$state"
    _replace_container "$state" "$target_image" "$target_source" "$merged_cpus" "$merged_memory" "$merged_pids" "$restart_policy"
  else
    _apply_live_limits "$cpus_set" "$cpus" "$memory_set" "$memory" "$pids_set" "$pids"
    if [[ "$state" != "running" ]]; then
      docker start "$SANDBOX" >/dev/null || _die "Could not start ${SANDBOX}."
      _wait_ready || _die "Sandbox ${SANDBOX} did not become ready."
    fi
    _restart_forwarders
  fi
  _release_lock
  _notice "Sandbox ${SANDBOX} is ready."
}

_parse_forwarded_env() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || _usage_error "Invalid environment variable name: ${name}"
  printenv "$name" >/dev/null 2>&1 || _die "Environment variable ${name} is not set; nothing was run."
}

_command_run() {
  local env_names="" name program status
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --env)
        [[ $# -ge 2 ]] || _usage_error "--env requires a variable name."
        _parse_forwarded_env "$2"
        env_names="${env_names} $2"
        shift 2
        ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  [[ $# -gt 0 ]] || _usage_error "run requires a command."
  program="$1"

  _ensure_docker
  _begin_session
  _acquire_lock
  _ensure_entry_sandbox_locked
  _warn_if_stale
  _release_lock

  if ! docker exec "$SANDBOX" sh -lc 'command -v "$1" >/dev/null 2>&1' sh "$program"; then
    _die "Program '${program}' is not installed in the sandbox. Install it under the persistent /home/aibox, or add it to ~/.aibox/Dockerfile.extra and rebuild a derivative image."
  fi

  set +e
  if [[ -n "$env_names" ]]; then
    local exec_prefix=(--env)
    # Variable names are validated above and therefore cannot contain spaces.
    # shellcheck disable=SC2086
    for name in $env_names; do
      exec_prefix+=("$name" --env)
    done
    unset 'exec_prefix[${#exec_prefix[@]}-1]'
    _docker_exec "${exec_prefix[@]}" "$SANDBOX" "$@"
  else
    _docker_exec "$SANDBOX" "$@"
  fi
  status=$?
  set -e
  return "$status"
}

_command_shell() {
  local shell_path status
  _ensure_docker
  _begin_session
  _acquire_lock
  _ensure_entry_sandbox_locked
  _warn_if_stale
  _release_lock

  shell_path="$(docker exec "$SANDBOX" sh -c 'command -v zsh || command -v bash || command -v sh')" \
    || _die "No supported shell (zsh, bash, or sh) exists in ${SANDBOX}."
  set +e
  if [[ $# -eq 0 ]]; then
    _docker_exec "$SANDBOX" "$shell_path"
  else
    _docker_exec "$SANDBOX" "$shell_path" -lc 'exec "$@"' aibox-shell "$@"
  fi
  status=$?
  set -e
  return "$status"
}

_schema3_container_ids() {
  docker ps --all --quiet --filter "label=aibox.schema=${SCHEMA_VERSION}"
}

_schema3_sandbox_ids() {
  docker ps --all --quiet \
    --filter "label=aibox.schema=${SCHEMA_VERSION}" \
    --filter 'label=aibox.role=sandbox'
}

_volume_size() {
  docker volume inspect --format '{{if .UsageData}}{{.UsageData.Size}} bytes{{else}}unavailable on this Docker runtime{{end}}' "$1" 2>/dev/null \
    || printf 'unavailable\n'
}

_forwarder_ids() {
  docker ps --all --quiet \
    --filter "label=aibox.schema=${SCHEMA_VERSION}" \
    --filter 'label=aibox.role=forward' \
    --filter "label=aibox.path=${PROJECT_DIR}"
}

_forwarder_name() {
  printf '%s-forward-%s\n' "$SANDBOX" "$1"
}

_valid_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 ))
}

_parse_forward_spec() {
  local spec="$1" host_port container_port
  case "$spec" in
    *:*) host_port="${spec%%:*}"; container_port="${spec#*:}" ;;
    *) host_port="$spec"; container_port="$spec" ;;
  esac
  _valid_port "$host_port" && _valid_port "$container_port" \
    || _usage_error "Invalid port-forward specification '${spec}'; use PORT or HOST_PORT:CONTAINER_PORT (1-65535)."
  printf '%s:%s\n' "$((10#$host_port))" "$((10#$container_port))"
}

_ensure_forwarder() {
  local host_port="$1" container_port="$2" name schema path role saved_host saved_port state
  name="$(_forwarder_name "$host_port")"
  if _resource_exists container "$name"; then
    schema="$(_resource_label container "$name" 'aibox.schema')"
    path="$(_resource_label container "$name" 'aibox.path')"
    role="$(_resource_label container "$name" 'aibox.role')"
    saved_host="$(_resource_label container "$name" 'aibox.forward.host')"
    saved_port="$(_resource_label container "$name" 'aibox.forward.port')"
    if [[ "$schema" != "$SCHEMA_VERSION" || "$path" != "$PROJECT_DIR" || "$role" != "forward" || "$saved_host" != "$host_port" ]]; then
      _die "Refusing foreign container named ${name}; inspect or remove it manually."
    fi
    if [[ "$saved_port" != "$container_port" ]]; then
      docker container rm --force "$name" >/dev/null \
        || _die "Could not replace the existing forward on host port ${host_port}."
    else
      state="$(docker container inspect --format '{{.State.Status}}' "$name")"
      if [[ "$state" != "running" ]]; then
        docker start "$name" >/dev/null \
          || _die "Could not bind 127.0.0.1:${host_port}; the host port may already be in use."
      fi
      _notice "Forward ready: 127.0.0.1:${host_port} -> ${SANDBOX}:${container_port}."
      return 0
    fi
  fi

  if ! docker image inspect "$FORWARD_IMAGE" >/dev/null 2>&1; then
    _notice "Pulling forwarder image ${FORWARD_IMAGE}..."
    docker pull "$FORWARD_IMAGE" >&2 \
      || _die "Could not pull forwarder image ${FORWARD_IMAGE}."
  fi
  if ! docker run -d \
    --name "$name" \
    --network "$NETWORK" \
    --restart unless-stopped \
    --publish "127.0.0.1:${host_port}:${container_port}" \
    --label "aibox.schema=${SCHEMA_VERSION}" \
    --label "aibox.path=${PROJECT_DIR}" \
    --label "aibox.slug=${SLUG}" \
    --label "aibox.hash=${HASH}" \
    --label "aibox.version=${CLI_VERSION}" \
    --label 'aibox.role=forward' \
    --label "aibox.forward.host=${host_port}" \
    --label "aibox.forward.port=${container_port}" \
    "$FORWARD_IMAGE" \
    "TCP-LISTEN:${container_port},fork,reuseaddr" "TCP:${SANDBOX}:${container_port}" >/dev/null; then
    if _resource_exists container "$name" \
      && [[ "$(_resource_label container "$name" 'aibox.schema')" == "$SCHEMA_VERSION" ]] \
      && [[ "$(_resource_label container "$name" 'aibox.path')" == "$PROJECT_DIR" ]]; then
      docker container rm --force "$name" >/dev/null 2>&1 || true
    fi
    _die "Could not bind 127.0.0.1:${host_port}; the host port may already be in use."
  fi
  _notice "Forward ready: 127.0.0.1:${host_port} -> ${SANDBOX}:${container_port}. Ensure the server listens on 0.0.0.0, not only the container loopback."
}

_list_forwarders() {
  local ids id host_port container_port state
  ids="$(_forwarder_ids)"
  if [[ -z "$ids" ]]; then
    printf 'No port forwards for %s.\n' "$PROJECT_DIR"
    return 0
  fi
  printf 'HOST\tCONTAINER\tSTATE\n'
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    host_port="$(_resource_label container "$id" 'aibox.forward.host')"
    container_port="$(_resource_label container "$id" 'aibox.forward.port')"
    state="$(docker container inspect --format '{{.State.Status}}' "$id")"
    printf '127.0.0.1:%s\t%s:%s\t%s\n' "$host_port" "$SANDBOX" "$container_port" "$state"
  done <<EOF
$ids
EOF
}

_remove_forwarders() {
  local host_port="${1:-}" ids
  if [[ -n "$host_port" ]]; then
    ids="$(docker ps --all --quiet \
      --filter "label=aibox.schema=${SCHEMA_VERSION}" \
      --filter 'label=aibox.role=forward' \
      --filter "label=aibox.path=${PROJECT_DIR}" \
      --filter "label=aibox.forward.host=${host_port}")"
  else
    ids="$(_forwarder_ids)"
  fi
  if [[ -n "$ids" ]]; then
    # shellcheck disable=SC2086
    docker container rm --force $ids >/dev/null
  fi
}

_command_port_forward() {
  local mode=create target="" pairs="" parsed host_port container_port
  if [[ "${1:-}" == "--list" ]]; then
    mode=list; shift
  elif [[ "${1:-}" == "--stop-all" ]]; then
    mode=stop-all; shift
  elif [[ "${1:-}" == "--stop" ]]; then
    [[ $# -ge 2 ]] || _usage_error "port-forward --stop requires a host port."
    mode=stop; target="$2"; shift 2
    _valid_port "$target" || _usage_error "Invalid host port '${target}'."
    target="$((10#$target))"
  else
    [[ $# -gt 0 ]] || _usage_error "port-forward requires a port specification or management option."
    while [[ $# -gt 0 ]]; do
      parsed="$(_parse_forward_spec "$1")"
      pairs="${pairs}${parsed} "
      shift
    done
  fi
  [[ $# -eq 0 ]] || _usage_error "Unexpected port-forward arguments."

  _ensure_docker
  _acquire_lock
  _assert_project_resources
  case "$mode" in
    list)
      _list_forwarders
      ;;
    stop)
      _remove_forwarders "$target"
      _notice "Removed the forward on 127.0.0.1:${target}, if it existed."
      ;;
    stop-all)
      _remove_forwarders
      _notice "Removed all port forwards for ${PROJECT_DIR}."
      ;;
    create)
      _ensure_entry_sandbox_locked
      # Parsed values are numeric and contain no spaces.
      # shellcheck disable=SC2086
      for parsed in $pairs; do
        host_port="${parsed%%:*}"
        container_port="${parsed#*:}"
        _ensure_forwarder "$host_port" "$container_port"
      done
      ;;
  esac
  _release_lock
}

_command_remove() {
  local purge=false yes=false ids answer
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --purge) purge=true ;;
      --yes) yes=true ;;
      *) _usage_error "Unknown remove option: $1" ;;
    esac
    shift
  done
  [[ "$yes" == false || "$purge" == true ]] || _usage_error "--yes is valid only with --purge."
  _ensure_docker
  _acquire_lock
  _assert_project_resources
  if [[ "$purge" == true && "$yes" == false ]]; then
    printf 'Delete sandbox and private home volume %s? [y/N] ' "$HOME_VOLUME" >&2
    read -r answer || answer=""
    case "$answer" in y|Y|yes|YES) ;; *) _notice "Cancelled; nothing was removed."; _release_lock; return 0 ;; esac
  fi

  ids="$(_forwarder_ids)"
  if [[ -n "$ids" ]]; then
    # shellcheck disable=SC2086
    docker container rm --force $ids >/dev/null
  fi
  if _resource_exists container "$SANDBOX"; then
    docker container rm --force "$SANDBOX" >/dev/null \
      || _die "Could not remove sandbox ${SANDBOX}."
  fi
  if _resource_exists network "$NETWORK"; then
    docker network rm "$NETWORK" >/dev/null \
      || _die "Could not remove network ${NETWORK}."
  fi
  if [[ "$purge" == true ]]; then
    if _resource_exists volume "$HOME_VOLUME"; then
      docker volume rm "$HOME_VOLUME" >/dev/null \
        || _die "Could not delete private home volume ${HOME_VOLUME}."
    fi
    _notice "Removed ${SANDBOX}, its network and forwards, and deleted private home volume ${HOME_VOLUME}."
  else
    _notice "Removed ${SANDBOX}, its network and forwards. Private home volume ${HOME_VOLUME} was retained."
    _notice "Delete it explicitly with: aibox --dir '${PROJECT_DIR}' remove --purge --yes"
  fi
  _release_lock
}

_command_stop() {
  local all=false ids forward_ids
  if [[ "${1:-}" == "--all" ]]; then
    all=true
    shift
  fi
  [[ $# -eq 0 ]] || _usage_error "stop accepts only --all."
  _ensure_docker

  if [[ "$all" == true ]]; then
    ids="$(_schema3_container_ids)"
    if [[ -n "$ids" ]]; then
      # shellcheck disable=SC2086
      docker stop $ids >/dev/null
    fi
    _notice "Stopped all schema-3 AI Box containers."
    return 0
  fi

  _acquire_lock
  _assert_project_resources
  forward_ids="$(_forwarder_ids)"
  if [[ -n "$forward_ids" ]]; then
    # shellcheck disable=SC2086
    docker stop $forward_ids >/dev/null
  fi
  if _resource_exists container "$SANDBOX"; then
    docker stop "$SANDBOX" >/dev/null
    _notice "Stopped ${SANDBOX}. Its private home volume was retained."
  else
    _notice "No sandbox exists for ${PROJECT_DIR}."
  fi
  _release_lock
}

_status_one() {
  local name="$1" path="$2" state image activity sessions stats size_rw pids memory nano_cpus
  local container_image_id current_image_id stale forward_count home_size
  SANDBOX="$name"
  state="$(docker container inspect --format '{{.State.Status}}' "$name")"
  image="$(docker container inspect --format '{{.Config.Image}}' "$name")"
  printf 'Project: %s\nSandbox: %s\nState: %s\nImage: %s\n' "$path" "$name" "$state" "$image"
  container_image_id="$(docker container inspect --format '{{.Image}}' "$name" 2>/dev/null || true)"
  current_image_id="$(docker image inspect --format '{{.Id}}' "$image" 2>/dev/null || true)"
  stale="unknown"
  if [[ -n "$container_image_id" && -n "$current_image_id" ]]; then
    stale="no"
    if [[ "$container_image_id" != "$current_image_id" ]]; then
      stale="yes"
    fi
  fi
  home_size="$(_volume_size "$name")"
  printf 'Image stale: %s\nPrivate home: %s (%s)\nNetwork: %s\n' "$stale" "$name" "$home_size" "$name"
  pids="$(docker container inspect --format '{{.HostConfig.PidsLimit}}' "$name")"
  memory="$(docker container inspect --format '{{.HostConfig.Memory}}' "$name")"
  nano_cpus="$(docker container inspect --format '{{.HostConfig.NanoCpus}}' "$name")"
  printf 'Limits: cpus=%s memory=%s pids=%s\n' "$nano_cpus" "$memory" "$pids"
  size_rw="$(docker container inspect --size --format '{{.SizeRw}}' "$name" 2>/dev/null || true)"
  printf 'Writable layer: %s bytes\n' "${size_rw:-unknown}"
  if [[ "$state" == "running" ]]; then
    stats="$(docker stats --no-stream --format '{{.CPUPerc}}|{{.MemUsage}}' "$name" 2>/dev/null || true)"
    printf 'Live usage: %s\n' "${stats:-unavailable}"
    activity="$(_activity_state)"
    printf 'Processes: %s\n' "$activity"
  fi
  sessions="$(_active_session_count)"
  forward_count="$(docker ps --all --quiet --filter "label=aibox.schema=${SCHEMA_VERSION}" --filter 'label=aibox.role=forward' --filter "label=aibox.path=${path}" | wc -l | tr -d ' ')"
  printf 'Active sessions: %s\nForwarders: %s\n' "$sessions" "$forward_count"
}

_status_all() {
  local ids id name path first=true
  ids="$(_schema3_sandbox_ids)"
  if [[ -z "$ids" ]]; then
    printf 'No schema-3 AI Box sandboxes found.\n'
    return 0
  fi
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    name="$(docker container inspect --format '{{.Name}}' "$id")"
    name="${name#/}"
    path="$(_resource_label container "$id" 'aibox.path')"
    [[ "$first" == true ]] || printf '\n'
    first=false
    _status_one "$name" "$path"
  done <<EOF
$ids
EOF
}

_command_status() {
  [[ $# -eq 0 ]] || _usage_error "status does not accept arguments."
  _ensure_docker
  if [[ -z "$PROJECT_DIR" ]]; then
    _status_all
    return 0
  fi
  _assert_project_resources
  if _resource_exists container "$SANDBOX"; then
    _status_one "$SANDBOX" "$PROJECT_DIR"
  elif _resource_exists volume "$HOME_VOLUME"; then
    printf 'Project: %s\nSandbox: %s\nState: absent\nPrivate home: retained\nRun: aibox --dir %q up\n' "$PROJECT_DIR" "$SANDBOX" "$PROJECT_DIR"
  else
    printf 'Project: %s\nSandbox: %s\nState: absent\n' "$PROJECT_DIR" "$SANDBOX"
  fi
}

_main() {
  local selected_dir="" command=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir)
        [[ -z "$command" ]] || _usage_error "--dir must appear before the command."
        [[ $# -ge 2 ]] || _usage_error "--dir requires a path."
        selected_dir="$2"
        shift 2
        ;;
      --*) _usage_error "Unknown global option: $1" ;;
      *) command="$1"; shift; break ;;
    esac
  done

  case "$command" in
    ""|up|run|shell|stop|status|remove|port-forward) _load_config ;;
  esac

  if [[ -n "$selected_dir" ]]; then
    _set_project "$selected_dir"
  elif ! _path_is_unsafe "$(pwd -P)"; then
    _set_project "$(pwd -P)"
  elif [[ "$command" != "status" && -n "$command" && "$command" != "help" && "$command" != "version" && ! ( "$command" == "stop" && "${1:-}" == "--all" ) ]]; then
    _die "Refusing unsafe project path: $(pwd -P). Select a specific project with --dir."
  fi

  trap _cleanup EXIT
  trap 'exit 130' HUP INT TERM

  if [[ -z "$command" ]]; then
    _help
    printf '\n'
    _command_status
    return 0
  fi

  case "$command" in
    up) _command_up "$@" ;;
    run) _command_run "$@" ;;
    shell) _command_shell "$@" ;;
    stop) _command_stop "$@" ;;
    status) _command_status "$@" ;;
    remove) _command_remove "$@" ;;
    port-forward) _command_port_forward "$@" ;;
    version)
      [[ $# -eq 0 ]] || _usage_error "version does not accept arguments."
      printf 'aibox %s (schema %s)\n' "$CLI_VERSION" "$SCHEMA_VERSION"
      ;;
    help)
      [[ $# -eq 0 ]] || _usage_error "help does not accept arguments."
      _help
      ;;
    *) _usage_error "Unknown command: ${command}" ;;
  esac
}

_main "$@"

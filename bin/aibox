#!/usr/bin/env bash
# aibox - one persistent, agent-neutral Docker sandbox per project.

set -euo pipefail
unset CDPATH

# Replaced by the release workflow. A checkout intentionally reports "dev".
CLI_VERSION="${AIBOX_CLI_VERSION:-__CLI_VERSION__}"
SCHEMA_VERSION="3"
NODE_VERSION="24"
DEFAULT_PIDS="4096"
CONFIG_DIR="${AIBOX_CONFIG_DIR:-${HOME}/.aibox}"

[[ "$CLI_VERSION" == "__CLI_VERSION__" ]] && CLI_VERSION="dev"

PROJECT_DIR=""
SLUG=""
HASH=""
SANDBOX=""
IMAGE=""
HOME_VOLUME=""
NETWORK=""
LOCK_PATH=""
SESSION_MARKER=""

_notice() { printf '%s\n' "$*" >&2; }
_warn() { printf 'Warning: %s\n' "$*" >&2; }
_die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
_usage_error() { printf 'Error: %s\nRun "aibox help" for usage.\n' "$*" >&2; exit 2; }

_help() {
  cat <<'HELP'
aibox - Run commands in a persistent, project-scoped Docker sandbox.

Usage:
  aibox
  aibox [--dir PATH] up
  aibox [--dir PATH] run [--env NAME]... <command> [arguments...]
  aibox [--dir PATH] shell [command...]
  aibox [--dir PATH] stop [--all]
  aibox [--dir PATH] status
  aibox version
  aibox help

The selected project is mounted read/write at the same absolute path. Its
private /home/aibox volume persists across stop and start. AI Box does not
install or launch an AI agent, expose ports, or provide remote transport.
HELP
}

_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -d' ' -f1
  else
    shasum -a 256 | cut -d' ' -f1
  fi
}

_load_config() {
  local key value
  [[ -f "${CONFIG_DIR}/config" ]] || return 0
  while IFS='=' read -r key value || [[ -n "$key" ]]; do
    [[ -z "$key" || "$key" == \#* || -z "$value" ]] && continue
    case "$key" in
      node_version)
        [[ "$value" =~ ^[0-9]+$ ]] \
          || _die "Invalid node_version in ${CONFIG_DIR}/config: expected a major version number."
        NODE_VERSION="$value"
        ;;
    esac
  done < "${CONFIG_DIR}/config"
}

_canonical_dir() {
  local selected="$1"
  [[ -d "$selected" ]] || _die "Project directory does not exist: ${selected}"
  (cd "$selected" && pwd -P)
}

_path_is_unsafe() {
  local path="$1"
  case "$path" in
    /|"$HOME"|/Users|/home|/Volumes|/mnt|/tmp|/var|/etc|/usr|/opt|/private|/private/tmp|/private/var|/private/etc|*:* ) return 0 ;;
  esac
  return 1
}

_set_project() {
  if _path_is_unsafe "${1%/}"; then
    _die "Refusing unsafe project path: ${1%/}. Select a specific project directory."
  fi
  PROJECT_DIR="$(_canonical_dir "$1")"
  if _path_is_unsafe "$PROJECT_DIR"; then
    _die "Refusing unsafe project path: ${PROJECT_DIR}. Select a specific project directory."
  fi

  SLUG="$(basename "$PROJECT_DIR" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g; s/_/-/g; s/^-*//; s/-*$//')"
  [[ -n "$SLUG" ]] || SLUG="project"
  SLUG="${SLUG:0:48}"
  HASH="$(printf '%s' "$PROJECT_DIR" | _sha256 | cut -c1-6)"
  SANDBOX="aibox-${SLUG}-${HASH}"
  HOME_VOLUME="$SANDBOX"
  NETWORK="$SANDBOX"
  IMAGE="aibox:${CLI_VERSION}-node${NODE_VERSION}"
  LOCK_PATH="${CONFIG_DIR}/locks/${SANDBOX}"
}

_docker_endpoint() {
  if [[ -n "${DOCKER_HOST:-}" ]]; then
    printf '%s\n' "$DOCKER_HOST"
    return 0
  fi
  docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null | head -1
}

_require_local_docker() {
  local endpoint
  command -v docker >/dev/null 2>&1 \
    || _die "Docker CLI not found. Install Docker, Colima, or OrbStack and retry."
  endpoint="$(_docker_endpoint)" || _die "Could not inspect the active Docker context."
  case "$endpoint" in
    unix://*) ;;
    *) _die "Refusing remote Docker endpoint ${endpoint:-unknown}. AI Box requires a local Unix socket because project bind paths belong to the daemon host." ;;
  esac
}

_ensure_docker() {
  _require_local_docker
  docker info >/dev/null 2>&1 && return 0

  if command -v colima >/dev/null 2>&1; then
    _notice "Docker is stopped; starting Colima..."
    colima start >&2
  elif [[ "$(uname -s)" == "Darwin" && -d /Applications/OrbStack.app ]]; then
    _notice "Docker is stopped; starting OrbStack..."
    open -a OrbStack
  elif [[ "$(uname -s)" == "Darwin" && -d /Applications/Docker.app ]]; then
    _notice "Docker is stopped; starting Docker Desktop..."
    open -a Docker
  else
    _die "Docker daemon is not reachable. Start it and retry (on Linux: sudo systemctl start docker)."
  fi

  local attempts=0
  until docker info >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    (( attempts < 60 )) || _die "Docker daemon did not become ready within 60 seconds. Start the installed runtime and retry."
    sleep 1
  done
}

_resource_exists() {
  local kind="$1" name="$2"
  case "$kind" in
    container) docker container inspect "$name" >/dev/null 2>&1 ;;
    volume) docker volume inspect "$name" >/dev/null 2>&1 ;;
    network) docker network inspect "$name" >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

_resource_label() {
  local kind="$1" name="$2" key="$3"
  case "$kind" in
    container) docker container inspect --format "{{ index .Config.Labels \"${key}\" }}" "$name" 2>/dev/null ;;
    volume) docker volume inspect --format "{{ index .Labels \"${key}\" }}" "$name" 2>/dev/null ;;
    network) docker network inspect --format "{{ index .Labels \"${key}\" }}" "$name" 2>/dev/null ;;
  esac
}

_assert_owned_resource() {
  local kind="$1" name="$2" schema path role
  _resource_exists "$kind" "$name" || return 0
  schema="$(_resource_label "$kind" "$name" 'aibox.schema')"
  path="$(_resource_label "$kind" "$name" 'aibox.path')"
  role="$(_resource_label "$kind" "$name" 'aibox.role')"
  if [[ "$schema" != "$SCHEMA_VERSION" || "$path" != "$PROJECT_DIR" || "$role" != "sandbox" ]]; then
    _die "Refusing foreign ${kind} named ${name}. Expected schema 3 sandbox labels for ${PROJECT_DIR}; inspect or remove it manually."
  fi
}

_assert_project_resources() {
  _assert_owned_resource container "$SANDBOX"
  _assert_owned_resource volume "$HOME_VOLUME"
  _assert_owned_resource network "$NETWORK"
}

_lock_owned_by_aibox() {
  local pid="$1" command_text
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  command_text="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  if [[ "$command_text" =~ (^|[\/[:space:]])aibox([[:space:]]|$) ]]; then
    return 0
  fi
  # A newly started Bash process can briefly appear before its script argument.
  # Recheck once when the run/shell marker proves this PID is in the handoff.
  if [[ -f "${CONFIG_DIR}/sessions/${SANDBOX}/${pid}" ]]; then
    sleep 0.02
    command_text="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    [[ "$command_text" =~ (^|[\/[:space:]])aibox([[:space:]]|$) ]] && return 0
  fi
  return 1
}

_release_lock() {
  local owner
  [[ -n "$LOCK_PATH" && -L "$LOCK_PATH" ]] || return 0
  owner="$(readlink "$LOCK_PATH" 2>/dev/null || true)"
  [[ "$owner" == "$$" ]] && rm -f -- "$LOCK_PATH"
  return 0
}

_acquire_lock() {
  local owner waits=0
  mkdir -p "${CONFIG_DIR}/locks"
  while ! ln -s "$$" "$LOCK_PATH" 2>/dev/null; do
    owner="$(readlink "$LOCK_PATH" 2>/dev/null || true)"
    if ! _lock_owned_by_aibox "$owner"; then
      rm -f -- "$LOCK_PATH" 2>/dev/null || true
      continue
    fi
    waits=$((waits + 1))
    if (( waits % 100 == 0 )); then
      _notice "Waiting for another AI Box operation on ${SANDBOX}..."
    fi
    sleep 0.1
  done
}

_cleanup() {
  AIBOX_EXIT_STATUS=$?
  trap - EXIT HUP INT TERM
  _release_lock
  [[ -n "$SESSION_MARKER" ]] && rm -f -- "$SESSION_MARKER" 2>/dev/null || true
  exit "$AIBOX_EXIT_STATUS"
}

_begin_session() {
  local session_dir="${CONFIG_DIR}/sessions/${SANDBOX}"
  mkdir -p "$session_dir"
  SESSION_MARKER="${session_dir}/$$"
  : > "$SESSION_MARKER"
}

_active_session_count() {
  local session_dir="${CONFIG_DIR}/sessions/${SANDBOX}" marker pid count=0
  [[ -d "$session_dir" ]] || { printf '0\n'; return 0; }
  for marker in "$session_dir"/*; do
    [[ -f "$marker" ]] || continue
    pid="${marker##*/}"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      count=$((count + 1))
    fi
  done
  printf '%s\n' "$count"
}

_write_build_inputs() {
  mkdir -p "$CONFIG_DIR"
  cat > "${CONFIG_DIR}/Dockerfile" <<DOCKERFILE
FROM node:${NODE_VERSION}-bookworm

RUN apt-get update \\
 && apt-get install -y --no-install-recommends zsh sudo ripgrep fzf jq less procps curl tmux \\
 && rm -rf /var/lib/apt/lists/*

RUN userdel -r node 2>/dev/null || true \\
 && useradd -m -u 1000 -s /usr/bin/zsh aibox \\
 && printf 'aibox ALL=(ALL) NOPASSWD:ALL\\n' > /etc/sudoers.d/aibox \\
 && chmod 0440 /etc/sudoers.d/aibox

ENV HOME=/home/aibox
ENV PATH=/home/aibox/.local/bin:\$PATH

COPY entrypoint.sh /usr/local/bin/aibox-entrypoint
RUN chmod 0755 /usr/local/bin/aibox-entrypoint
USER aibox
WORKDIR /home/aibox
ENTRYPOINT ["/usr/local/bin/aibox-entrypoint"]
CMD ["sleep", "infinity"]
DOCKERFILE

  if [[ -f "${CONFIG_DIR}/Dockerfile.extra" ]]; then
    printf '\n' >> "${CONFIG_DIR}/Dockerfile"
    cat "${CONFIG_DIR}/Dockerfile.extra" >> "${CONFIG_DIR}/Dockerfile"
  fi

  cat > "${CONFIG_DIR}/entrypoint.sh" <<'ENTRYPOINT'
#!/usr/bin/env bash
set -e
rm -f /tmp/aibox-ready
sudo chown aibox:aibox /home/aibox
if [[ ! -e /home/aibox/.zshrc ]]; then
  printf 'autoload -Uz compinit && compinit\nPROMPT="%%F{cyan}%%1~%%f %%# "\n' > /home/aibox/.zshrc
fi
touch /tmp/aibox-ready
exec "$@"
ENTRYPOINT
  chmod 0755 "${CONFIG_DIR}/entrypoint.sh"
  printf '*\n!Dockerfile\n!entrypoint.sh\n' > "${CONFIG_DIR}/.dockerignore"
}

_build_fingerprint() {
  { cat "${CONFIG_DIR}/Dockerfile"; cat "${CONFIG_DIR}/entrypoint.sh"; } | _sha256
}

_check_disk_space() {
  local available_kb
  available_kb="$(df -Pk "$CONFIG_DIR" | awk 'NR == 2 { print $4 }')"
  [[ "$available_kb" =~ ^[0-9]+$ ]] || _die "Could not determine free disk space before building ${IMAGE}."
  if (( available_kb < 5242880 )); then
    _die "Less than 5 GB is free on the Docker host filesystem. Free space before building ${IMAGE}."
  elif (( available_kb < 10485760 )); then
    _warn "Less than 10 GB is free; the image build may exhaust disk space."
  fi
}

_image_fingerprint() {
  docker image inspect --format '{{ index .Config.Labels "aibox.build-fingerprint" }}' "$IMAGE" 2>/dev/null || true
}

_ensure_image() {
  local wanted current
  _write_build_inputs
  wanted="$(_build_fingerprint)"
  current="$(_image_fingerprint)"
  [[ "$current" == "$wanted" ]] && return 0
  _check_disk_space
  _notice "Building ${IMAGE}; this may take a few minutes on first use..."
  docker build --pull --label "aibox.build-fingerprint=${wanted}" -t "$IMAGE" "$CONFIG_DIR" >&2 \
    || _die "Failed to build ${IMAGE}. Review the Docker output above and retry."
  _notice "Built ${IMAGE}."
}

_container_state() {
  if ! _resource_exists container "$SANDBOX"; then
    printf 'absent\n'
  else
    docker container inspect --format '{{.State.Status}}' "$SANDBOX"
  fi
}

_create_support_resources() {
  if ! _resource_exists network "$NETWORK"; then
    if ! docker network create \
      --label "aibox.schema=${SCHEMA_VERSION}" \
      --label "aibox.path=${PROJECT_DIR}" \
      --label "aibox.slug=${SLUG}" \
      --label "aibox.hash=${HASH}" \
      --label "aibox.version=${CLI_VERSION}" \
      --label 'aibox.role=sandbox' \
      "$NETWORK" >/dev/null; then
      _die "Could not create network ${NETWORK}. If Docker reports address-pool exhaustion, configure smaller default-address-pools in the Docker daemon."
    fi
  fi

  if ! _resource_exists volume "$HOME_VOLUME"; then
    docker volume create \
      --label "aibox.schema=${SCHEMA_VERSION}" \
      --label "aibox.path=${PROJECT_DIR}" \
      --label "aibox.slug=${SLUG}" \
      --label "aibox.hash=${HASH}" \
      --label "aibox.version=${CLI_VERSION}" \
      --label 'aibox.role=sandbox' \
      "$HOME_VOLUME" >/dev/null \
      || _die "Could not create private home volume ${HOME_VOLUME}."
  fi
}

_create_container() {
  docker create \
    --name "$SANDBOX" \
    --hostname "${SLUG:0:63}" \
    --network "$NETWORK" \
    --restart unless-stopped \
    --init \
    --pids-limit "$DEFAULT_PIDS" \
    --add-host host.docker.internal:host-gateway \
    --workdir "$PROJECT_DIR" \
    --mount "type=bind,src=${PROJECT_DIR},dst=${PROJECT_DIR}" \
    --mount "type=volume,src=${HOME_VOLUME},dst=/home/aibox" \
    --label "aibox.schema=${SCHEMA_VERSION}" \
    --label "aibox.path=${PROJECT_DIR}" \
    --label "aibox.slug=${SLUG}" \
    --label "aibox.hash=${HASH}" \
    --label "aibox.version=${CLI_VERSION}" \
    --label 'aibox.role=sandbox' \
    --label 'aibox.image-source=default' \
    "$IMAGE" sleep infinity >/dev/null \
    || _die "Could not create ${SANDBOX}. Check the bind path and Docker error above."
}

_wait_ready() {
  local attempts=0
  until docker exec "$SANDBOX" test -f /tmp/aibox-ready >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if (( attempts >= 50 )); then
      docker logs "$SANDBOX" >&2 || true
      _die "Sandbox ${SANDBOX} did not become ready."
    fi
    sleep 0.1
  done
}

_ensure_sandbox_locked() {
  local state
  _assert_project_resources
  _ensure_image
  _create_support_resources
  state="$(_container_state)"

  if [[ "$state" == "created" ]]; then
    _notice "Replacing incomplete Created-state sandbox ${SANDBOX}..."
    docker container rm "$SANDBOX" >/dev/null \
      || _die "Could not remove incomplete sandbox ${SANDBOX}."
    state="absent"
  fi

  case "$state" in
    absent)
      _notice "Creating sandbox ${SANDBOX}..."
      _create_container
      docker start "$SANDBOX" >/dev/null || _die "Could not start ${SANDBOX}."
      ;;
    running) ;;
    exited|dead)
      _notice "Starting sandbox ${SANDBOX}..."
      docker start "$SANDBOX" >/dev/null || _die "Could not start ${SANDBOX}."
      ;;
    restarting)
      _notice "Waiting for restarting sandbox ${SANDBOX}..."
      ;;
    *) _die "Sandbox ${SANDBOX} is ${state}; resolve that Docker state and retry." ;;
  esac
  _wait_ready
}

_container_is_stale() {
  local container_image current_image
  _resource_exists container "$SANDBOX" || return 1
  container_image="$(docker container inspect --format '{{.Image}}' "$SANDBOX" 2>/dev/null || true)"
  current_image="$(docker image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null || true)"
  [[ -n "$container_image" && -n "$current_image" && "$container_image" != "$current_image" ]]
}

_warn_if_stale() {
  if _container_is_stale; then
    _warn "Sandbox ${SANDBOX} uses an older default image. Milestone 2 does not replace existing sandboxes."
  fi
}

_activity_state() {
  local init_pid top_output pid ppid args init_seen=0 idle_seen=0 unexpected=0 rows=0
  init_pid="$(docker container inspect --format '{{.State.Pid}}' "$SANDBOX" 2>/dev/null || true)"
  if [[ ! "$init_pid" =~ ^[1-9][0-9]*$ ]]; then
    _warn "Cannot establish safety for ${SANDBOX}: Docker did not report its init PID."
    printf 'unknown\n'
    return 0
  fi
  if ! top_output="$(docker top "$SANDBOX" -eo pid,ppid,args 2>/dev/null)"; then
    _warn "Cannot establish safety for ${SANDBOX}: docker top failed."
    printf 'unknown\n'
    return 0
  fi

  while read -r pid ppid args; do
    [[ "$pid" =~ ^[0-9]+$ && "$ppid" =~ ^[0-9]+$ ]] || continue
    rows=$((rows + 1))
    if [[ "$pid" == "$init_pid" ]]; then
      init_seen=$((init_seen + 1))
    elif [[ "$ppid" == "$init_pid" && "$args" =~ (^|/)sleep[[:space:]]+infinity$ ]]; then
      idle_seen=$((idle_seen + 1))
    else
      unexpected=$((unexpected + 1))
    fi
  done <<EOF
$top_output
EOF

  if (( rows == 0 || init_seen != 1 || idle_seen != 1 )); then
    _warn "Cannot establish safety for ${SANDBOX}: Docker process data did not contain the expected init and idle process."
    printf 'unknown\n'
  elif (( unexpected > 0 )); then
    printf 'active\n'
  else
    printf 'idle\n'
  fi
}

_docker_exec() {
  local args=(exec -i)
  if [[ -t 0 && -t 1 ]]; then
    args=(exec -it)
  fi
  docker "${args[@]}" "$@"
}

_command_up() {
  [[ $# -eq 0 ]] || _usage_error "up does not accept options in Milestone 2."
  _ensure_docker
  _acquire_lock
  _ensure_sandbox_locked
  _warn_if_stale
  _release_lock
  _notice "Sandbox ${SANDBOX} is ready."
}

_parse_forwarded_env() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || _usage_error "Invalid environment variable name: ${name}"
  printenv "$name" >/dev/null 2>&1 || _die "Environment variable ${name} is not set; nothing was run."
}

_command_run() {
  local env_names="" name program status
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --env)
        [[ $# -ge 2 ]] || _usage_error "--env requires a variable name."
        _parse_forwarded_env "$2"
        env_names="${env_names} $2"
        shift 2
        ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  [[ $# -gt 0 ]] || _usage_error "run requires a command."
  program="$1"

  _ensure_docker
  _begin_session
  _acquire_lock
  _ensure_sandbox_locked
  _warn_if_stale
  _release_lock

  if ! docker exec "$SANDBOX" sh -lc 'command -v "$1" >/dev/null 2>&1' sh "$program"; then
    _die "Program '${program}' is not installed in the sandbox. Install it under the persistent /home/aibox, or add it to ~/.aibox/Dockerfile.extra and rebuild a derivative image."
  fi

  set +e
  if [[ -n "$env_names" ]]; then
    local exec_prefix=(--env)
    # Variable names are validated above and therefore cannot contain spaces.
    # shellcheck disable=SC2086
    for name in $env_names; do
      exec_prefix+=("$name" --env)
    done
    unset 'exec_prefix[${#exec_prefix[@]}-1]'
    _docker_exec "${exec_prefix[@]}" "$SANDBOX" "$@"
  else
    _docker_exec "$SANDBOX" "$@"
  fi
  status=$?
  set -e
  return "$status"
}

_command_shell() {
  local shell_path status
  _ensure_docker
  _begin_session
  _acquire_lock
  _ensure_sandbox_locked
  _warn_if_stale
  _release_lock

  shell_path="$(docker exec "$SANDBOX" sh -c 'command -v zsh || command -v bash || command -v sh')" \
    || _die "No supported shell (zsh, bash, or sh) exists in ${SANDBOX}."
  set +e
  if [[ $# -eq 0 ]]; then
    _docker_exec "$SANDBOX" "$shell_path"
  else
    _docker_exec "$SANDBOX" "$shell_path" -lc 'exec "$@"' aibox-shell "$@"
  fi
  status=$?
  set -e
  return "$status"
}

_schema3_container_ids() {
  docker ps --all --quiet --filter "label=aibox.schema=${SCHEMA_VERSION}"
}

_schema3_sandbox_ids() {
  docker ps --all --quiet \
    --filter "label=aibox.schema=${SCHEMA_VERSION}" \
    --filter 'label=aibox.role=sandbox'
}

_command_stop() {
  local all=false ids forward_ids
  if [[ "${1:-}" == "--all" ]]; then
    all=true
    shift
  fi
  [[ $# -eq 0 ]] || _usage_error "stop accepts only --all."
  _ensure_docker

  if [[ "$all" == true ]]; then
    ids="$(_schema3_container_ids)"
    if [[ -n "$ids" ]]; then
      # shellcheck disable=SC2086
      docker stop $ids >/dev/null
    fi
    _notice "Stopped all schema-3 AI Box containers."
    return 0
  fi

  _acquire_lock
  _assert_project_resources
  if _resource_exists container "$SANDBOX"; then
    forward_ids="$(docker ps --all --quiet --filter "label=aibox.schema=${SCHEMA_VERSION}" --filter 'label=aibox.role=forward' --filter "label=aibox.path=${PROJECT_DIR}")"
    if [[ -n "$forward_ids" ]]; then
      # shellcheck disable=SC2086
      docker stop $forward_ids >/dev/null
    fi
    docker stop "$SANDBOX" >/dev/null
    _notice "Stopped ${SANDBOX}. Its private home volume was retained."
  else
    _notice "No sandbox exists for ${PROJECT_DIR}."
  fi
  _release_lock
}

_status_one() {
  local name="$1" path="$2" state image activity sessions stats size_rw pids memory nano_cpus
  local container_image_id current_image_id stale forward_count
  SANDBOX="$name"
  state="$(docker container inspect --format '{{.State.Status}}' "$name")"
  image="$(docker container inspect --format '{{.Config.Image}}' "$name")"
  printf 'Project: %s\nSandbox: %s\nState: %s\nImage: %s\n' "$path" "$name" "$state" "$image"
  container_image_id="$(docker container inspect --format '{{.Image}}' "$name" 2>/dev/null || true)"
  current_image_id="$(docker image inspect --format '{{.Id}}' "$image" 2>/dev/null || true)"
  stale="unknown"
  if [[ -n "$container_image_id" && -n "$current_image_id" ]]; then
    stale="no"
    if [[ "$container_image_id" != "$current_image_id" ]]; then
      stale="yes"
    fi
  fi
  printf 'Image stale: %s\nPrivate home: %s\nNetwork: %s\n' "$stale" "$name" "$name"
  pids="$(docker container inspect --format '{{.HostConfig.PidsLimit}}' "$name")"
  memory="$(docker container inspect --format '{{.HostConfig.Memory}}' "$name")"
  nano_cpus="$(docker container inspect --format '{{.HostConfig.NanoCpus}}' "$name")"
  printf 'Limits: cpus=%s memory=%s pids=%s\n' "$nano_cpus" "$memory" "$pids"
  size_rw="$(docker container inspect --size --format '{{.SizeRw}}' "$name" 2>/dev/null || true)"
  printf 'Writable layer: %s bytes\n' "${size_rw:-unknown}"
  if [[ "$state" == "running" ]]; then
    stats="$(docker stats --no-stream --format '{{.CPUPerc}}|{{.MemUsage}}' "$name" 2>/dev/null || true)"
    printf 'Live usage: %s\n' "${stats:-unavailable}"
    activity="$(_activity_state)"
    printf 'Processes: %s\n' "$activity"
  fi
  sessions="$(_active_session_count)"
  forward_count="$(docker ps --all --quiet --filter "label=aibox.schema=${SCHEMA_VERSION}" --filter 'label=aibox.role=forward' --filter "label=aibox.path=${path}" | wc -l | tr -d ' ')"
  printf 'Active sessions: %s\nForwarders: %s\n' "$sessions" "$forward_count"
}

_status_all() {
  local ids id name path first=true
  ids="$(_schema3_sandbox_ids)"
  if [[ -z "$ids" ]]; then
    printf 'No schema-3 AI Box sandboxes found.\n'
    return 0
  fi
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    name="$(docker container inspect --format '{{.Name}}' "$id")"
    name="${name#/}"
    path="$(_resource_label container "$id" 'aibox.path')"
    [[ "$first" == true ]] || printf '\n'
    first=false
    _status_one "$name" "$path"
  done <<EOF
$ids
EOF
}

_command_status() {
  [[ $# -eq 0 ]] || _usage_error "status does not accept arguments."
  _ensure_docker
  if [[ -z "$PROJECT_DIR" ]]; then
    _status_all
    return 0
  fi
  _assert_project_resources
  if _resource_exists container "$SANDBOX"; then
    _status_one "$SANDBOX" "$PROJECT_DIR"
  elif _resource_exists volume "$HOME_VOLUME"; then
    printf 'Project: %s\nSandbox: %s\nState: absent\nPrivate home: retained\nRun: aibox --dir %q up\n' "$PROJECT_DIR" "$SANDBOX" "$PROJECT_DIR"
  else
    printf 'Project: %s\nSandbox: %s\nState: absent\n' "$PROJECT_DIR" "$SANDBOX"
  fi
}

_main() {
  local selected_dir="" command=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir)
        [[ -z "$command" ]] || _usage_error "--dir must appear before the command."
        [[ $# -ge 2 ]] || _usage_error "--dir requires a path."
        selected_dir="$2"
        shift 2
        ;;
      --*) _usage_error "Unknown global option: $1" ;;
      *) command="$1"; shift; break ;;
    esac
  done

  case "$command" in
    ""|up|run|shell|stop|status) _load_config ;;
  esac

  if [[ -n "$selected_dir" ]]; then
    _set_project "$selected_dir"
  elif ! _path_is_unsafe "$(pwd -P)"; then
    _set_project "$(pwd -P)"
  elif [[ "$command" != "status" && -n "$command" && "$command" != "help" && "$command" != "version" && ! ( "$command" == "stop" && "${1:-}" == "--all" ) ]]; then
    _die "Refusing unsafe project path: $(pwd -P). Select a specific project with --dir."
  fi

  trap _cleanup EXIT
  trap 'exit 130' HUP INT TERM

  if [[ -z "$command" ]]; then
    _help
    printf '\n'
    _command_status
    return 0
  fi

  case "$command" in
    up) _command_up "$@" ;;
    run) _command_run "$@" ;;
    shell) _command_shell "$@" ;;
    stop) _command_stop "$@" ;;
    status) _command_status "$@" ;;
    version)
      [[ $# -eq 0 ]] || _usage_error "version does not accept arguments."
      printf 'aibox %s (schema %s)\n' "$CLI_VERSION" "$SCHEMA_VERSION"
      ;;
    help)
      [[ $# -eq 0 ]] || _usage_error "help does not accept arguments."
      _help
      ;;
    *) _usage_error "Unknown command: ${command}" ;;
  esac
}

_main "$@"
